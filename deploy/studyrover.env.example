# StudyRover backend runtime config (consumed by systemd EnvironmentFile).
# Copy to studyrover.env and fill in secrets. deploy.sh generates studyrover.env
# automatically (random SESSION_SECRET + provisioned DB password) if absent.

PORT=8080

# Postgres on the existing local instance (deploy.sh provisions role + db).
DATABASE_URL=postgres://studyrover:CHANGE_ME@127.0.0.1:5432/studyrover?sslmode=disable

# Session cookie signing secret (use: openssl rand -hex 32).
SESSION_SECRET=CHANGE_ME

# WebAuthn / FIDO2 relying party (parent auth). RP_ID is the registrable domain;
# the origin is the https URL the user visits. The /studyrover subpath is NOT
# part of RP_ID or origin (WebAuthn is path-agnostic).
RP_ID=home.cloudlabs.live
RP_ORIGIN=https://home.cloudlabs.live

# STORAGE_DIR — local dir for uploaded source files (optional).
STORAGE_DIR=/var/lib/studyrover/storage

# Ollama Cloud — optional. When set and settings.knowledge_backend='ollama',
# DeepSeek authors exam questions/study guides from curriculum knowledge (no
# ingested sources needed). Get a key at https://ollama.com/settings/keys.
OLLAMA_API_KEY=CHANGE_ME
OLLAMA_MODEL=deepseek-v4-pro
OLLAMA_BASE_URL=https://ollama.com

# z.ai (Zhipu GLM) — optional alternative to Ollama. Select via
# settings.knowledge_backend='zai'. Get a key at https://z.ai (requires balance).
ZAI_API_KEY=CHANGE_ME
ZAI_MODEL=glm-5.2
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Codex — optional, bring your own ChatGPT/Codex subscription (no API key).
# Install the Codex CLI and sign it in ONCE as the user the service runs as:
#   codex login            (or `codex login --device-auth` on a headless box)
# then select settings.knowledge_backend='codex' (Settings page). Each AI call
# runs one `codex exec` in a read-only sandbox and counts against that plan's
# usage limits. CODEX_BIN must be an absolute path: systemd's PATH is short.
# CODEX_HOME / CODEX_MODEL are optional (defaults: ~/.codex, the plan default).
CODEX_BIN=/home/CHANGE_ME/.local/bin/codex
#CODEX_HOME=/home/CHANGE_ME/.codex
#CODEX_MODEL=

# Lessons / Enrich — optional. The "Enrich" action on a class lesson searches
# YouTube (Data API v3) and Wikipedia for the topic and attaches the best
# matches. Wikipedia needs no key. YouTube needs an API key from Google Cloud
# (APIs & Services → enable "YouTube Data API v3" → Credentials → API key);
# without it YouTube is skipped with a warning in the job result. Each search
# costs 100 of the free 10,000 daily quota units.
# YOUTUBE_API_KEY=CHANGE_ME
# WIKIPEDIA_LANG=en                # Wikipedia edition to search (default en)

# ---------------------------------------------------------------------------
# Guardian (Phase 3) — reward engine + network wall. OFF by default: with
# GUARDIAN_ENABLED unset the server is exactly the Phase 1+2 study platform and
# no Guardian code runs. See deploy/README.md "Guardian (Phase 3)".
# ---------------------------------------------------------------------------
# GUARDIAN_ENABLED=true            # "true" or "1" turns the Guardian on
# GUARDIAN_WALL=fake               # fake (default, in-memory, no hardware) | routeros
# GUARDIAN_FAKE_DEVICES=aa:bb:cc:dd:ee:01=mayas-laptop,aa:bb:cc:dd:ee:02=tablet
#                                  # optional; seeds the fake wall's "scan" (mac=hostname, comma-separated)

# RouterOS wall (required when GUARDIAN_WALL=routeros). RouterOS v7 REST API,
# https recommended; use a dedicated router user with write access to
# /ip/firewall and /ip/hotspot.
# ROUTEROS_URL=https://192.168.88.1
# ROUTEROS_USER=studyrover
# ROUTEROS_PASSWORD=CHANGE_ME
# ROUTEROS_INSECURE_TLS=true       # accept the router's self-signed certificate
# ROUTEROS_HOTSPOT_SERVER=         # /ip/hotspot server name gating the kids' devices (empty = first/only)
